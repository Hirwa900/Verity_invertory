# Firebase web app config (safe to publish — these are public client identifiers).
# Get them from: Firebase Console > Project Settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=verity-inventory.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=verity-inventory
VITE_FIREBASE_STORAGE_BUCKET=verity-inventory.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Base URL of the Express API (functions/src/server.js) that serves the
# business operations (createSale, createPurchase, ...).
# Local dev: http://localhost:8080   Deployed: https://your-api-host.example
# PUBLIC value only — VITE_* variables ship in the browser bundle, so NEVER
# put service accounts, private keys, or passwords here.
VITE_FUNCTIONS_API_BASE=http://localhost:8080
