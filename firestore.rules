rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function activeProfile() {
      return get(/databases/$(database)/documents/verity_users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.role == 'admin'
        && activeProfile().role == 'admin'
        && activeProfile().isActive == true;
    }

    function isActiveSeller() {
      return signedIn()
        && request.auth.token.role == 'seller'
        && activeProfile().role == 'seller'
        && activeProfile().isActive == true;
    }

    function isStaff() {
      return isAdmin() || isActiveSeller();
    }

    match /verity_users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if false;
    }

    match /verity_categories/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /verity_products/{id} {
      allow read: if isStaff();
      allow create: if isAdmin()
        && request.resource.data.quantity == 0
        && request.resource.data.isActive == true;
      allow update: if isAdmin()
        && request.resource.data.quantity == resource.data.quantity;
      allow delete: if false;
    }

    match /verity_sales/{id} {
      allow read: if isAdmin() || (isActiveSeller() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /verity_purchases/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /verity_stockMovements/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /verity_expenses/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /verity_auditEvents/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /verity_idempotency/{id} {
      allow read, write: if false;
    }

    match /verity_meta/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
